---
import '../../brand/fonts/fonts.css';
import '../../brand/tokens/colors.css';
import '../styles/site.css';
import lockupUrl from '../../brand/logo/lockup-horizontal-ink.svg?url';
import CopyButton from '../components/copy-button.astro';
import { links } from '../components/links.ts';
import docs from '../generated/cli-docs.json';

// The 404 page answers at every unknown address, so it names no canonical URL of its own.
type Props = { title: string; description: string; isNotFound?: boolean };

const { title, description, isNotFound = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og-image.png', Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {isNotFound ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#26335C" />
    <meta name="color-scheme" content="light" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="storehouse" />
    <meta property="og:title" content="storehouse" />
    <meta property="og:description" content={description} />
    {!isNotFound && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="The storehouse seal and wordmark on green-bar paper."
    />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <a href="/" class="lockup">
        <img src={lockupUrl} alt="storehouse" width="220" height="43" />
      </a>
      <nav aria-label="Main">
        <ul>
          <li><a href={links.docs}>Docs</a></li>
          <li><a href={links.repo}>GitHub</a></li>
        </ul>
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="footer-install">
        <code>{docs.install}</code>
        <CopyButton text={docs.install} what="the install command" />
      </div>
      <ul class="footer-links">
        <li><a href={links.repo}>GitHub</a></li>
        <li><a href={links.npm}>npm</a></li>
        <li><a href={links.license}>MIT license</a></li>
      </ul>
    </footer>
    <p id="copy-status" class="visually-hidden" aria-live="polite"></p>
  </body>
</html>
