// What `pnpm build` emits to dist/: the source without its tests, with .ts imports made .js.
{
  "extends": "./tsconfig.node.json",
  "compilerOptions": {
    "noEmit": false,
    "allowImportingTsExtensions": false,
    "rewriteRelativeImportExtensions": true,
    "declaration": true,
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": null
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts", "src/testing"]
}
